<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styles/form.css" />
        <title><%= post ? 'Edit Post' : 'New Post' %></title>
    </head>
    <body>
        <form action="/posts" method="POST">
            <h1><%= post ? 'Edit Post' : 'Add New Post' %></h1>
            <input type="hidden" name="id" value="<%= post ? post.id : '' %>">
            <input type="hidden" name="username" value="<%= username %>">
            
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required>

            <label for="description">Description:</label>
            <textarea id="description" name="description" required><%= post ? post.description : '' %></textarea>

            <button type="submit"><%= post ? 'Update Post' : 'Create Post' %></button>
        </form>
    </body>
</html>
